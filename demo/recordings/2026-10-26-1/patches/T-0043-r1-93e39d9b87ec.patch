+import { describe, expect, it } from 'vitest';
+import { setup } from './helpers';
+
+describe('admin API rate limiting', () => {
+  it('returns 429 with Retry-After when tenant creation exceeds the limit', async () => {
+    const { send } = setup({ rateLimitMaxRequests: 2, rateLimitWindowMs: 60_000 });
+    const create = (id: string) =>
+      send('/admin/tenants', { method: 'POST', body: JSON.stringify({ id, name: `Tenant ${id}` }) });
+
+    expect((await create('tenant-c')).status).toBe(201);
+    expect((await create('tenant-d')).status).toBe(201);
+
+    const res = await create('tenant-e');
+    expect(res.status).toBe(429);
+    expect(await res.json()).toEqual({ error: 'rate limit exceeded' });
+    const retryAfter = res.headers.get('Retry-After');
+    expect(retryAfter).not.toBeNull();
+    expect(Number(retryAfter)).toBeGreaterThan(0);
+  });
+
+  it('limits reads and writes through one shared bucket', async () => {
+    const { send } = setup({ rateLimitMaxRequests: 2, rateLimitWindowMs: 60_000 });
+
+    expect((await send('/admin/tenants')).status).toBe(200);
+    expect(
+      (
+        await send('/admin/tenants', {
+          method: 'POST',
+          body: JSON.stringify({ id: 'tenant-c', name: 'Tenant C' }),
+        })
+      ).status,
+    ).toBe(201);
+    expect((await send('/admin/tenants')).status).toBe(429);
+  });
+
+  it('does not share the bucket with webhook traffic', async () => {
+    const { send, postWebhook } = setup({ rateLimitMaxRequests: 1, rateLimitWindowMs: 60_000 });
+
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: 'b' })).status).toBe(429);
+    expect((await send('/admin/tenants')).status).toBe(200);
+  });
+});
