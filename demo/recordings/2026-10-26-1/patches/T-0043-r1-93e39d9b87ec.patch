 export function adminRoutes(deps: Deps): Hono {
   const r = new Hono();
 
+  // Shared fixed-window bucket for all admin requests, which carry no tenant.
+  // The key uses characters invalid in tenant ids so it can never collide
+  // with the per-tenant webhook buckets in the same limiter.
+  r.use(async (c, next) => {
+    const verdict = deps.rateLimiter.consume('__admin__');
+    if (!verdict.allowed) {
+      const retryAfter = Math.max(1, Math.ceil(verdict.msUntilReset / 1000));
+      return c.json({ error: 'rate limit exceeded' }, 429, { 'Retry-After': String(retryAfter) });
+    }
+    await next();
+  });
