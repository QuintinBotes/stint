+import { describe, expect, it } from 'vitest';
+import { setup } from './helpers';
+
+describe('POST /webhooks rate limiting', () => {
+  it('accepts webhooks under the limit', async () => {
+    const { postWebhook } = setup({ rateLimitMaxRequests: 3, rateLimitWindowMs: 60_000 });
+    for (let i = 0; i < 3; i++) {
+      const res = await postWebhook('tenant-a', { type: 'invoice.paid' });
+      expect(res.status).toBe(202);
+    }
+  });
+
+  it('returns 429 with Retry-After when a tenant exceeds the limit', async () => {
+    const { postWebhook } = setup({ rateLimitMaxRequests: 2, rateLimitWindowMs: 60_000 });
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: 'b' })).status).toBe(202);
+
+    const res = await postWebhook('tenant-a', { type: 'c' });
+    expect(res.status).toBe(429);
+    const retryAfter = res.headers.get('Retry-After');
+    expect(retryAfter).not.toBeNull();
+    expect(Number(retryAfter)).toBeGreaterThan(0);
+  });
+
+  it('does not rate-limit other tenants when one tenant is over the limit', async () => {
+    const { postWebhook } = setup({ rateLimitMaxRequests: 1, rateLimitWindowMs: 60_000 });
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: 'b' })).status).toBe(429);
+    expect((await postWebhook('tenant-b', { type: 'a' })).status).toBe(202);
+  });
+});
