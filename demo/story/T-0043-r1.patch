--- a/test/admin.test.ts
+++ b/test/admin.test.ts
@@ -35,3 +35,21 @@ describe('admin API', () => {
     expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(202);
   });
 });
+
+describe('admin rate limit', () => {
+  it('answers 429 with Retry-After over the configured admin limit', async () => {
+    const { send } = setup({ adminRateLimit: 2 });
+    await send('/admin/tenants');
+    await send('/admin/tenants');
+    const res = await send('/admin/tenants');
+    expect(res.status).toBe(429);
+    expect(Number(res.headers.get('Retry-After'))).toBeGreaterThan(0);
+  });
+
+  it('uses the window from config', async () => {
+    const { send } = setup({ adminRateLimit: 1, adminRateWindowMs: 1 });
+    await send('/admin/tenants');
+    await new Promise((r) => setTimeout(r, 5));
+    expect((await send('/admin/tenants')).status).toBe(200);
+  });
+});
