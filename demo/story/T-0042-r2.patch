new file mode 100644
index 0000000..3dbdc1e
--- /dev/null
+++ b/src/lib/limiter.ts
@@ -0,0 +1,26 @@
+export interface LimitResult {
+  allowed: boolean;
+  retryAfterMs: number;
+}
+
+// Sliding window log per tenant: a burst at a window edge cannot double the limit.
+export class SlidingWindowLimiter {
+  private hits = new Map<string, number[]>();
+
+  constructor(
+    private readonly limit = 60,
+    private readonly windowMs = 60_000,
+  ) {}
+
+  check(tenant: string, now = Date.now()): LimitResult {
+    const start = now - this.windowMs;
+    const recent = (this.hits.get(tenant) ?? []).filter((t) => t > start);
+    if (recent.length >= this.limit) {
+      this.hits.set(tenant, recent);
+      return { allowed: false, retryAfterMs: (recent[0] ?? now) + this.windowMs - now };
+    }
+    recent.push(now);
+    this.hits.set(tenant, recent);
+    return { allowed: true, retryAfterMs: 0 };
+  }
+}
