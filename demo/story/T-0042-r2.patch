diff --git a/test/limiter.test.ts b/test/limiter.test.ts
new file mode 100644
index 0000000..5dadf10
--- /dev/null
+++ b/test/limiter.test.ts
@@ -0,0 +1,23 @@
+import { describe, expect, it } from 'vitest';
+import { SlidingWindowLimiter } from '../src/lib/limiter';
+
+describe('sliding window limiter', () => {
+  it('allows requests up to the limit', () => {
+    const limiter = new SlidingWindowLimiter(3, 1000);
+    expect([0, 1, 2].map((t) => limiter.check('tenant-a', t).allowed)).toEqual([true, true, true]);
+  });
+
+  it('blocks a request over the limit and says when to retry', () => {
+    const limiter = new SlidingWindowLimiter(2, 1000);
+    limiter.check('tenant-a', 0);
+    limiter.check('tenant-a', 100);
+    expect(limiter.check('tenant-a', 200)).toEqual({ allowed: false, retryAfterMs: 800 });
+  });
+
+  it('lets requests through again once old hits leave the window', () => {
+    const limiter = new SlidingWindowLimiter(1, 1000);
+    limiter.check('tenant-a', 0);
+    expect(limiter.check('tenant-a', 500).allowed).toBe(false);
+    expect(limiter.check('tenant-a', 1001).allowed).toBe(true);
+  });
+});
