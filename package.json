{
  "name": "stint",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.3.14"
  },
  "workspaces": [
    "packages/*",
    "packages/adapters/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b",
    "test": "bun test",
    "build:web": "bun run --cwd apps/web build",
    "build:judge": "bun apps/web/scripts/build-judge.ts",
    "serve:judge": "bun apps/web/scripts/serve-judge.ts",
    "test:judge": "bun run build:judge && bun run --cwd apps/web playwright test -c e2e/judge/playwright.config.ts",
    "dev": "bash scripts/dev.sh",
    "demo": "bun run build:web && bun packages/cli/bin/stint demo --keep --open",
    "test:ui": "bun run --cwd apps/web test:ui",
    "fixture": "bash scripts/fixture.sh",
    "bootstrap": "bash scripts/bootstrap.sh",
    "dev:web": "bun run --cwd apps/web dev",
    "check": "bash scripts/check.sh"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "5.9.3"
  },
  "license": "MIT"
}
