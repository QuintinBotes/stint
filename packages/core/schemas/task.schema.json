{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stint.dev/schemas/task/1",
  "title": "stint.task/1",
  "description": "Stable facts about a task. The daemon is the only writer. Status is the factory state machine.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "id",
    "slug",
    "title",
    "goal",
    "acceptance",
    "baseCommit",
    "branch",
    "status",
    "testCommand",
    "budgets",
    "links",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "version": {
      "const": "stint.task/1"
    },
    "id": {
      "type": "string",
      "pattern": "^T-[0-9]{4,}$"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "goal": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 300
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "baseCommit": {
      "type": "string",
      "minLength": 7
    },
    "branch": {
      "type": "string",
      "pattern": "^stint/T-[0-9]{4,}$"
    },
    "status": {
      "type": "string",
      "enum": [
        "planned",
        "building",
        "verifying",
        "reviewing",
        "in_review",
        "awaiting_approval",
        "approved",
        "rejected",
        "done",
        "abandoned"
      ]
    },
    "assignee": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "adapter",
            "role",
            "run"
          ],
          "properties": {
            "adapter": {
              "type": "string"
            },
            "model": {
              "type": "string"
            },
            "role": {
              "type": "string",
              "enum": [
                "planner",
                "implementer",
                "reviewer"
              ]
            },
            "run": {
              "type": "string",
              "pattern": "^r[0-9]+$"
            }
          }
        }
      ]
    },
    "testCommand": {
      "type": "string",
      "minLength": 1
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "planner",
        "implementer",
        "reviewer"
      ],
      "properties": {
        "planner": {
          "type": "integer",
          "minimum": 0
        },
        "implementer": {
          "type": "integer",
          "minimum": 0
        },
        "reviewer": {
          "type": "integer",
          "minimum": 0
        },
        "learn": {
          "type": "integer",
          "minimum": 0
        },
        "usdCap": {
          "type": "number",
          "minimum": 0
        },
        "tester": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "routes": {
      "type": "object",
      "additionalProperties": false,
      "description": "Per-role route overrides for this task, used before the config chains.",
      "properties": {
        "planner": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/.+$"
          }
        },
        "implementer": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/.+$"
          }
        },
        "reviewer": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/.+$"
          }
        },
        "tester": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/.+$"
          }
        },
        "learn": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/.+$"
          }
        },
        "agent": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/.+$"
          }
        },
        "summary": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/.+$"
          }
        },
        "quiz": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/.+$"
          }
        },
        "recall": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9-]+/.+$"
          }
        }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beadsId": {
          "type": [
            "string",
            "null"
          ]
        },
        "issueUrl": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        }
      }
    },
    "pendingAsk": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400,
      "description": "The next ask carried from a rejection, request-changes or review comments."
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "checks": {
      "type": "array",
      "maxItems": 8,
      "description": "The verify suite the daemon runs beside testCommand.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "command",
          "kind"
        ],
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,39}$"
          },
          "command": {
            "type": "string",
            "minLength": 1,
            "maxLength": 400
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "typecheck",
              "lint",
              "custom"
            ]
          }
        }
      }
    },
    "parent": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^T-[0-9]{4,}$",
      "description": "The task this one was split from."
    },
    "dependsOn": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "pattern": "^T-[0-9]{4,}$"
      },
      "description": "Tasks this one waits for."
    },
    "risk": {
      "type": [
        "string",
        "null"
      ],
      "enum": [
        "low",
        "medium",
        "high",
        null
      ],
      "description": "The risk tier that decides how much gating the task needs."
    },
    "source": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "required": [
        "kind",
        "ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "manual",
            "github",
            "linear",
            "gardening"
          ]
        },
        "ref": {
          "type": "string",
          "maxLength": 200
        },
        "url": {
          "type": "string",
          "format": "uri"
        }
      },
      "description": "Where the task came from."
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "description": "Builds, hand-offs, review rounds, spend and agent time autopilot may use before it stops and asks. A field left out takes the config default; null means no limit.",
      "properties": {
        "builds": { "type": ["integer", "null"], "minimum": 1, "maximum": 50 },
        "handoffs": { "type": ["integer", "null"], "minimum": 0, "maximum": 20 },
        "reviewRounds": { "type": ["integer", "null"], "minimum": 0, "maximum": 10 },
        "usd": { "type": ["number", "null"], "exclusiveMinimum": 0, "maximum": 1000 },
        "minutes": { "type": ["integer", "null"], "minimum": 1, "maximum": 1440 }
      }
    },
    "proofs": {
      "type": "array",
      "maxItems": 12,
      "description": "How each acceptance criterion is proven. criterion counts from 1, the first line of acceptance.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "criterion",
          "kind",
          "ref"
        ],
        "properties": {
          "criterion": {
            "type": "integer",
            "minimum": 1,
            "maximum": 12
          },
          "kind": {
            "type": "string",
            "enum": [
              "test",
              "scenario",
              "check",
              "human",
              "visual"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "description": "A test name or part of one, a scenario name, a check name, or what a person checks."
          }
        }
      }
    },
    "goalId": {
      "type": "string",
      "pattern": "^G-[0-9]{4,}$",
      "description": "The goal this task is part of (stint.goal/1)."
    },
    "goalCriteria": {
      "type": "array",
      "maxItems": 12,
      "description": "The goal's criteria this task covers, counting from 1.",
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 12
      }
    }
  }
}
