{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stint.dev/schemas/task/1",
  "title": "stint.task/1",
  "description": "Stable facts about a task. The daemon is the only writer. Status is the factory state machine.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "id", "slug", "title", "goal", "acceptance", "baseCommit", "branch", "status", "testCommand", "budgets", "links", "createdAt", "updatedAt"],
  "properties": {
    "version": { "const": "stint.task/1" },
    "id": { "type": "string", "pattern": "^T-[0-9]{4,}$" },
    "slug": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
    "title": { "type": "string", "minLength": 1, "maxLength": 120 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "acceptance": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
    "tags": { "type": "array", "items": { "type": "string" } },
    "baseCommit": { "type": "string", "minLength": 7 },
    "branch": { "type": "string", "pattern": "^stint/T-[0-9]{4,}$" },
    "status": { "type": "string", "enum": ["planned", "building", "verifying", "reviewing", "awaiting_approval", "approved", "rejected", "done", "abandoned"] },
    "assignee": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["adapter", "role", "run"],
          "properties": {
            "adapter": { "type": "string" },
            "model": { "type": "string" },
            "role": { "type": "string", "enum": ["planner", "implementer", "reviewer"] },
            "run": { "type": "string", "pattern": "^r[0-9]+$" }
          }
        }
      ]
    },
    "testCommand": { "type": "string", "minLength": 1 },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner", "implementer", "reviewer"],
      "properties": {
        "planner": { "type": "integer", "minimum": 0 },
        "implementer": { "type": "integer", "minimum": 0 },
        "reviewer": { "type": "integer", "minimum": 0 },
        "learn": { "type": "integer", "minimum": 0 },
        "usdCap": { "type": "number", "minimum": 0 }
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "beadsId": { "type": ["string", "null"] },
        "issueUrl": { "type": ["string", "null"], "format": "uri" }
      }
    },
    "pendingAsk": { "type": ["string", "null"], "maxLength": 400, "description": "The next ask carried from a rejection, request-changes or review comments." },
    "createdAt": { "type": "string", "format": "date-time" },
    "updatedAt": { "type": "string", "format": "date-time" }
  }
}
