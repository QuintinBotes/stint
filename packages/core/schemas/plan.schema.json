{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stint.dev/schemas/plan/1",
  "title": "stint.plan/1",
  "description": "Planner output. Structured output from Muse Wonder (or local Glimmer); plan.md is rendered from it for humans.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "steps",
    "filesToTouch",
    "risks",
    "similarTasks",
    "model"
  ],
  "properties": {
    "version": {
      "const": "stint.plan/1"
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text",
          "files"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "minimum": 1
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          },
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "test": {
            "type": "string",
            "maxLength": 200,
            "description": "The test that proves this step, if one is planned."
          }
        }
      }
    },
    "filesToTouch": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^R[0-9]+$"
          },
          "text": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "decisions": {
      "type": "array",
      "maxItems": 8,
      "description": "Decisions the plan asserts; the daemon records each as decision.recorded.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text"
        ],
        "properties": {
          "text": {
            "type": "string",
            "maxLength": 200
          },
          "why": {
            "type": "string",
            "maxLength": 300
          }
        }
      }
    },
    "similarTasks": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^T-[0-9]{4,}$"
      }
    },
    "constraints": {
      "type": "array",
      "maxItems": 20,
      "description": "Decisions and open findings on the files this task names, from the memory graph; the daemon fills it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "id",
          "task",
          "text",
          "files"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "decision",
              "finding"
            ]
          },
          "id": {
            "type": "string",
            "maxLength": 80
          },
          "task": {
            "type": "string",
            "pattern": "^T-[0-9]{4,}$"
          },
          "text": {
            "type": "string",
            "maxLength": 400
          },
          "files": {
            "type": "array",
            "maxItems": 20,
            "items": {
              "type": "string"
            }
          }
        }
      }
    },
    "subtasks": {
      "type": "array",
      "maxItems": 6,
      "description": "Only for a task too large for one run: the parts, each small enough for one run. dependsOn lists the indexes (from 0) of earlier subtasks that must be merged first.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "title",
          "goal",
          "acceptance",
          "dependsOn"
        ],
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "goal": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 300
            }
          },
          "dependsOn": {
            "type": "array",
            "maxItems": 5,
            "items": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "offline": {
      "type": "boolean"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    }
  }
}
