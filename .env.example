# Copy to .env (bootstrap does it) and fill in what you have. Bun loads .env automatically.
# Nothing here is ever committed or written into a packet.

# Meta Model API (https://dev.meta.ai). Meta's docs call this MODEL_API_KEY; Stint reads META_API_KEY.
META_API_KEY=

# No Anthropic key: every model Stint calls at runtime is a Meta model (hackathon rule). The Claude Code
# harness, when it takes the continue hop, runs on Meta's Anthropic-compatible API with META_API_KEY.

# Muse Spark Open hosted by Meta's hosting partners (hackathon credits).
BASETEN_API_KEY=
FIREWORKS_API_KEY=
# Modal: the OpenAI-compatible base URL of your Muse Spark Open endpoint and its token.
MODAL_BASE_URL=
MODAL_API_KEY=
