# Copy to .env (bootstrap does it) and fill in what you have. Bun loads .env automatically.
# Nothing here is ever committed or written into a packet.

# Meta Model API (https://dev.meta.ai). Meta's docs call this MODEL_API_KEY; Stint reads META_API_KEY.
META_API_KEY=

# Every model Stint calls at runtime is a Meta model. The Stint agent runs Muse Spark through META_API_KEY,
# or Muse Spark Open through the partner keys below when the Meta API is busy.

# Muse Spark Open hosted by Meta's hosting partners (hackathon credits).
BASETEN_API_KEY=
FIREWORKS_API_KEY=
# Modal: the OpenAI-compatible base URL of your Muse Spark Open endpoint and its token.
MODAL_BASE_URL=
MODAL_API_KEY=

# The identity guard's key for scripts/guard-identity.denylist.hmac; CI holds the same value as a repository secret.
STINT_GUARD_KEY=

# Docker (compose.yaml reads this file too; docs/docker.md). The repository Stint works on, mounted at /repo:
STINT_REPO=
# The port on this machine's 127.0.0.1 (default 4319):
# STINT_HOST_PORT=4319
# On Linux, the repository owner's ids, as `id -u` and `id -g` print them (default 1000):
# STINT_UID=1000
# STINT_GID=1000
# Who the merges made in the container are by; without these the daemon signs them "Stint daemon":
# GIT_AUTHOR_NAME=
# GIT_AUTHOR_EMAIL=
# GIT_COMMITTER_NAME=
# GIT_COMMITTER_EMAIL=
