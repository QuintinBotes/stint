        "muse-spark-open": "accounts/fireworks/models/muse-spark-open"
      },
      "offline": false,
      "structuredOutput": "enforced"
    },
    "meta-api": {
      "baseURL": "https://api.meta.ai/v1",
      "cachedInput": true,
      "keyEnv": "META_API_KEY",
      "models": {
        "muse-spark-1.3": "muse-spark-1.3",
        "muse-wonder-1.0": "muse-wonder-1.0"
