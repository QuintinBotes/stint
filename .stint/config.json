{
  "adapters": {
    "muse-code": {
      "enabled": true,
      "maxModelSteps": 60,
      "model": "muse-spark-1.3",
      "timeoutMs": 900000
    },
    "replay": {
      "enabled": true
    },
    "stint-agent": {
      "enabled": true,
      "maxTurns": 40,
      "model": "muse-spark-1.3"
    }
  },
  "agents": {
    "claude-code": {
      "command": [
        "claude",
        "-p",
        "--permission-mode",
        "acceptEdits"
      ],
      "enabled": false,
      "prompt": "stdin",
      "roles": [
        "implementer",
        "reviewer"
      ],
      "vendor": "anthropic"
    },
    "codex": {
      "command": [
        "codex",
        "exec",
        "--full-auto",
        "-"
      ],
      "enabled": false,
      "prompt": "stdin",
      "roles": [
        "implementer",
        "reviewer"
      ],
      "vendor": "openai"
    }
  },
  "autopilot": {
    "implementers": [
      "muse-code",
      "stint-agent"
    ],
    "maxHops": 3,
    "parallel": 2
  },
  "branchRetentionDays": 7,
  "budgets": {
    "implementer": 150000,
    "learn": 20000,
    "planner": 40000,
    "reviewer": 30000
  },
  "credits": {
    "baseten": 100,
    "fireworks": 25,
    "meta-api": 150,
    "modal": 100
  },
  "hosts": {
    "baseten": {
      "baseURL": "https://inference.baseten.co/v1",
      "cachedInput": true,
