+++ b/src/unit-option.test.ts
@@ -0,0 +1,83 @@
+import { describe, expect, it } from '@jest/globals';
+import { format, ms, parse, parseStrict } from './index';
+
+describe('unit option', () => {
+  it('formats into the given unit (short)', () => {
+    expect(format(5400000, { unit: 'm' })).toBe('90m');
+    expect(format(3600000, { unit: 'hrs' })).toBe('1h');
+    expect(format(2000, { unit: 's' })).toBe('2s');
+    expect(format(500, { unit: 'ms' })).toBe('500ms');
+    expect(format(1500, { unit: 'ms' })).toBe('1500ms');
+  });
+
+  it('formats into the given unit (long)', () => {
+    expect(format(5400000, { unit: 'minutes', long: true })).toBe('90 minutes');
+    expect(format(60000, { unit: 'm', long: true })).toBe('1 minute');
+    expect(format(3600000, { unit: 'HRS', long: true })).toBe('1 hour');
+    expect(format(1500, { unit: 'ms', long: true })).toBe('1500 ms');
+    expect(format(500, { unit: 'Milliseconds', long: true })).toBe('500 ms');
+  });
+
+  it('accepts any spelling and case the parser takes', () => {
+    expect(format(5400000, { unit: 'M' })).toBe('90m');
+    expect(format(5400000, { unit: 'Minutes' })).toBe('90m');
+    expect(format(5400000, { unit: 'MINS' })).toBe('90m');
+    expect(format(3600000, { unit: 'hrs' })).toBe('1h');
+    expect(format(86400000, { unit: 'Days' })).toBe('1d');
+    expect(format(604800000, { unit: 'WEEKS' })).toBe('1w');
+    expect(format(31557600000, { unit: 'Years' })).toBe('1y');
+    expect(format(2629800000, { unit: 'mo' })).toBe('1mo');
+    expect(format(1000, { unit: 'Seconds' })).toBe('1s');
+    expect(format(100, { unit: 'MS' })).toBe('100ms');
+  });
+
+  it('rounds to a whole number of that unit', () => {
+    expect(format(1500, { unit: 's' })).toBe('2s');
+    expect(format(1499, { unit: 's' })).toBe('1s');
+    expect(format(90000, { unit: 'm', long: true })).toBe('2 minutes');
+  });
+
+  it('throws on unknown format unit and names it', () => {
+    expect(() => format(1000, { unit: 'fortnights' as never })).toThrow(
+      /fortnights/,
+    );
+  });
+
+  it('parses unitless strings in the given unit', () => {
+    expect(parse('90', { unit: 's' })).toBe(90000);
+    expect(parse('90', { unit: 'Minutes' })).toBe(5400000);
+    expect(parse('90', { unit: 'MINS' })).toBe(5400000);
+    expect(parse('1.5', { unit: 'h' })).toBe(5400000);
+    expect(parse('-2', { unit: 'd' })).toBe(-172800000);
+  });
+
+  it('prefers the unit in the string over the option', () => {
+    expect(parse('2m', { unit: 's' })).toBe(120000);
+    expect(parse('1h', { unit: 's' })).toBe(3600000);
+  });
+
+  it('leaves behavior unchanged without the option', () => {
+    expect(parse('100')).toBe(100);
+    expect(parse('1m')).toBe(60000);
+  });
+
+  it('returns NaN for invalid strings even with the option', () => {
+    expect(Number.isNaN(parse('foo', { unit: 's' }))).toBe(true);
+  });
+
+  it('throws on unknown parse unit and names it', () => {
+    expect(() => parse('90', { unit: 'fortnights' as never })).toThrow(
+      /fortnights/,
+    );
+  });
+
+  it('supports unit via ms()', () => {
+    expect(ms(5400000, { unit: 'm' })).toBe('90m');
+    expect(ms('90', { unit: 's' })).toBe(90000);
+    expect(ms('2m', { unit: 's' })).toBe(120000);
+  });
+
+  it('supports unit via parseStrict()', () => {
+    expect(parseStrict('90' as never, { unit: 's' })).toBe(90000);
+  });
+});
