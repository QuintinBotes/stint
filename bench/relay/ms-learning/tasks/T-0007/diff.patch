+/**
+ * Return the mean in milliseconds of a list of durations, each a duration
+ * string or a number of milliseconds.
+ *
+ * @param values - A non-empty array of durations (e.g. `['1m', '3m']`)
+ * @returns The mean in milliseconds
+ * @throws Error if `values` is not a non-empty array, or if any element is
+ * not a string or a finite number
+ */
+export function average(values: (StringValue | number)[]): number {
+  if (!Array.isArray(values) || values.length === 0) {
+    throw new Error(
+      `Value provided to average() must be a non-empty array. value=${JSON.stringify(values)}`,
+    );
+  }
+  let sum = 0;
+  for (const value of values) {
+    sum += toMilliseconds(value, 'average');
+  }
+  return sum / values.length;
+}
