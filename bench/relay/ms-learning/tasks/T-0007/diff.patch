+import { describe, expect, it } from '@jest/globals';
+import { average } from './index';
+
+describe('average', () => {
+  it('should average duration strings', () => {
+    expect(average(['1m', '3m'])).toBe(120000);
+  });
+
+  it('should average mixed numbers and strings', () => {
+    expect(average([1000, '3s'])).toBe(2000);
+  });
+
+  it('should average numbers', () => {
+    expect(average([1000, 2000, 3000])).toBe(2000);
+  });
+
+  it('should average a single value', () => {
+    expect(average(['1m'])).toBe(60000);
+    expect(average([1500])).toBe(1500);
+  });
+
+  it('should work with negative durations', () => {
+    expect(average(['-1m', '3m'])).toBe(60000);
+    expect(average([-1000, 3000])).toBe(1000);
+  });
+
+  it('should throw for an empty array', () => {
+    expect(() => average([])).toThrow();
+  });
+
+  it('should throw for non-array input', () => {
+    // @ts-expect-error - We expect this to throw.
+    expect(() => average(undefined)).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => average('1m')).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => average(1000)).toThrow();
+  });
+
+  it('should throw for non-finite numbers', () => {
+    expect(() => average([NaN, '1s'])).toThrow();
+    expect(() => average(['1s', Infinity])).toThrow();
+  });
+
+  it('should throw for invalid element types', () => {
+    // @ts-expect-error - We expect this to throw.
+    expect(() => average([undefined, '1s'])).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => average(['1s', null])).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => average([{}])).toThrow();
+  });
+});
