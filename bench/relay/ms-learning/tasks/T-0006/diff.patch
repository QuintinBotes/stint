+import { describe, expect, it } from '@jest/globals';
+import { between } from './index';
+
+describe('between', () => {
+  it('should return true for a value strictly inside the bounds', () => {
+    expect(between('90s', '1m', '2m')).toBe(true);
+  });
+
+  it('should include both bounds', () => {
+    expect(between('1m', '1m', '2m')).toBe(true);
+    expect(between('2m', '1m', '2m')).toBe(true);
+  });
+
+  it('should return false for values outside the bounds', () => {
+    expect(between('30s', '1m', '2m')).toBe(false);
+    expect(between('3m', '1m', '2m')).toBe(false);
+  });
+
+  it('should accept numbers for all arguments', () => {
+    expect(between(1500, 1000, 2000)).toBe(true);
+    expect(between(1000, 1000, 2000)).toBe(true);
+    expect(between(2000, 1000, 2000)).toBe(true);
+    expect(between(500, 1000, 2000)).toBe(false);
+    expect(between(2500, 1000, 2000)).toBe(false);
+  });
+
+  it('should accept mixed strings and numbers', () => {
+    expect(between(90000, '1m', '2m')).toBe(true);
+    expect(between('90s', 60000, 120000)).toBe(true);
+  });
+
+  it('should work with negative durations', () => {
+    expect(between('-30m', '-1h', '1h')).toBe(true);
+    expect(between('-2h', '-1h', '1h')).toBe(false);
+  });
+
+  it('should throw for non-finite numbers', () => {
+    expect(() => between(NaN, '1m', '2m')).toThrow();
+    expect(() => between('90s', NaN, '2m')).toThrow();
+    expect(() => between('90s', '1m', NaN)).toThrow();
+    expect(() => between(Infinity, '1m', '2m')).toThrow();
+    expect(() => between('90s', '1m', -Infinity)).toThrow();
+  });
+
+  it('should throw for invalid types', () => {
+    // @ts-expect-error - We expect this to throw.
+    expect(() => between(undefined, '1m', '2m')).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => between('90s', null, '2m')).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => between('90s', '1m', {})).toThrow();
+  });
+});
