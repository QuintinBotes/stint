+/**
+ * Whether a duration lies between two others, bounds included.
+ *
+ * @param value - A duration string (e.g. `'90s'`) or a number of milliseconds
+ * @param min - A duration string (e.g. `'1m'`) or a number of milliseconds
+ * @param max - A duration string (e.g. `'2m'`) or a number of milliseconds
+ * @returns `true` if `value` lies in the inclusive range `[min, max]`
+ * @throws Error if any argument is not a string or a finite number
+ */
+export function between(
+  value: StringValue | number,
+  min: StringValue | number,
+  max: StringValue | number,
+): boolean {
+  const msValue = toMilliseconds(value, 'between');
+  const msMin = toMilliseconds(min, 'between');
+  const msMax = toMilliseconds(max, 'between');
+  return msValue >= msMin && msValue <= msMax;
+}
