+import { describe, expect, it } from '@jest/globals';
+import { compare } from './index';
+
+describe('compare', () => {
+  it('should sort duration strings ascending', () => {
+    expect(['1h', '5m', '30s'].sort(compare)).toEqual(['30s', '5m', '1h']);
+  });
+
+  it('should return 0 for equal durations', () => {
+    expect(compare('60s', '1m')).toBe(0);
+    expect(compare('1h', '1h')).toBe(0);
+  });
+
+  it('should return -1 when the first duration is shorter', () => {
+    expect(compare('30s', '1m')).toBe(-1);
+    expect(compare('5m', '1h')).toBe(-1);
+  });
+
+  it('should return 1 when the first duration is longer', () => {
+    expect(compare('1m', '30s')).toBe(1);
+    expect(compare('1h', '5m')).toBe(1);
+  });
+
+  it('should accept numbers for both arguments', () => {
+    expect(compare(1000, 2000)).toBe(-1);
+    expect(compare(2000, 1000)).toBe(1);
+    expect(compare(1000, 1000)).toBe(0);
+  });
+
+  it('should accept mixed strings and numbers', () => {
+    expect(compare(1000, '1s')).toBe(0);
+    expect(compare('1s', 1000)).toBe(0);
+    expect(compare(999, '1s')).toBe(-1);
+    expect(compare('2s', 1000)).toBe(1);
+  });
+
+  it('should work with negative durations', () => {
+    expect(compare('-1h', '1h')).toBe(-1);
+    expect(compare('1h', '-1h')).toBe(1);
+    expect(compare('-1h', -3600000)).toBe(0);
+  });
+
+  it('should throw for non-finite numbers', () => {
+    expect(() => compare(NaN, '1s')).toThrow();
+    expect(() => compare('1s', NaN)).toThrow();
+    expect(() => compare(Infinity, 1000)).toThrow();
+    expect(() => compare(1000, -Infinity)).toThrow();
+  });
+
+  it('should throw for invalid types', () => {
+    // @ts-expect-error - We expect this to throw.
+    expect(() => compare(undefined, '1s')).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => compare('1s', null)).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => compare({}, [])).toThrow();
+  });
+});
