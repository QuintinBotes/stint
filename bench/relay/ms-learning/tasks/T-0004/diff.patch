+/**
+ * Compare two durations for use as a sort comparator, each a duration string
+ * or a number of milliseconds.
+ *
+ * @param a - A duration string (e.g. `'1h'`) or a number of milliseconds
+ * @param b - A duration string (e.g. `'30m'`) or a number of milliseconds
+ * @returns `-1` if `a` is shorter than `b`, `1` if `a` is longer than `b`,
+ * and `0` if they are equal
+ * @throws Error if either argument is not a string or a finite number
+ */
+export function compare(a: string | number, b: string | number): number {
+  const msA = toMilliseconds(a, 'compare');
+  const msB = toMilliseconds(b, 'compare');
+  if (msA < msB) {
+    return -1;
+  }
+  if (msA > msB) {
+    return 1;
+  }
+  return 0;
+}
