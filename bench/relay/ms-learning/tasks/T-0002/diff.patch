+/**
+ * Return the sum in milliseconds of two durations, each a duration string or
+ * a number of milliseconds.
+ *
+ * @param a - A duration string (e.g. `'1h'`) or a number of milliseconds
+ * @param b - A duration string (e.g. `'30m'`) or a number of milliseconds
+ * @returns The sum in milliseconds
+ * @throws Error if either argument is not a string or a finite number
+ */
+export function add(
+  a: StringValue | number,
+  b: StringValue | number,
+): number {
+  return toMilliseconds(a) + toMilliseconds(b);
+}
+
+/**
+ * Convert a duration string or a number of milliseconds to milliseconds.
+ */
+function toMilliseconds(value: StringValue | number): number {
+  if (typeof value === 'string') {
+    return parse(value);
+  }
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) {
+      throw new Error(
+        `Value provided to add() must be a finite number. value=${JSON.stringify(value)}`,
+      );
+    }
+    return value;
+  }
+  throw new Error(
+    `Value provided to add() must be a string or number. value=${JSON.stringify(value)}`,
+  );
+}
+
