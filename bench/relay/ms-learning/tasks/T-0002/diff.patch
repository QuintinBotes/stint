+import { describe, expect, it } from '@jest/globals';
+import { add } from './index';
+
+describe('add', () => {
+  it('should add two duration strings', () => {
+    expect(add('1h', '30m')).toBe(5400000);
+  });
+
+  it('should add a number and a duration string', () => {
+    expect(add(1000, '1s')).toBe(2000);
+  });
+
+  it('should add two numbers', () => {
+    expect(add(1000, 2000)).toBe(3000);
+  });
+
+  it('should add a duration string and a number', () => {
+    expect(add('1s', 1000)).toBe(2000);
+  });
+
+  it('should work with negative durations', () => {
+    expect(add('-1h', '30m')).toBe(-1800000);
+    expect(add('1h', -1800000)).toBe(1800000);
+  });
+
+  it('should throw for non-finite numbers', () => {
+    expect(() => add(NaN, '1s')).toThrow();
+    expect(() => add('1s', NaN)).toThrow();
+    expect(() => add(Infinity, 1000)).toThrow();
+    expect(() => add(1000, -Infinity)).toThrow();
+  });
+
+  it('should throw for invalid types', () => {
+    // @ts-expect-error - We expect this to throw.
+    expect(() => add(undefined, '1s')).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => add('1s', null)).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => add({}, [])).toThrow();
+  });
+});
