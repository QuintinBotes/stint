+import { describe, expect, it } from '@jest/globals';
+import { scale } from './index';
+
+describe('scale', () => {
+  it('should scale a duration string by a factor', () => {
+    expect(scale('90s', 2)).toBe(180000);
+    expect(scale('1h', 0.5)).toBe(1800000);
+  });
+
+  it('should scale a number of milliseconds by a factor', () => {
+    expect(scale(1000, 3)).toBe(3000);
+    expect(scale(1000, 0.5)).toBe(500);
+  });
+
+  it('should work with zero and negative factors', () => {
+    expect(scale('1s', 0)).toBe(0);
+    expect(scale('1s', -2)).toBe(-2000);
+    expect(scale('-1h', 2)).toBe(-7200000);
+  });
+
+  it('should throw for non-finite factors', () => {
+    expect(() => scale('1s', NaN)).toThrow();
+    expect(() => scale('1s', Infinity)).toThrow();
+    expect(() => scale(1000, -Infinity)).toThrow();
+  });
+
+  it('should throw for invalid factor types', () => {
+    // @ts-expect-error - We expect this to throw.
+    expect(() => scale('1s', undefined)).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => scale('1s', '2')).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => scale('1s', null)).toThrow();
+  });
+
+  it('should throw for non-finite numbers', () => {
+    expect(() => scale(NaN, 2)).toThrow();
+    expect(() => scale(Infinity, 2)).toThrow();
+  });
+
+  it('should throw for invalid value types', () => {
+    // @ts-expect-error - We expect this to throw.
+    expect(() => scale(undefined, 2)).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => scale(null, 2)).toThrow();
+  });
+});
