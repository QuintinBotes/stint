+/**
+ * Scale a duration by a factor, returning the result in milliseconds.
+ *
+ * @param value - A duration string (e.g. `'90s'`) or a number of milliseconds
+ * @param factor - The factor to multiply the duration by
+ * @returns The scaled duration in milliseconds
+ * @throws Error if `value` is not a string or a finite number, or if
+ * `factor` is not a finite number
+ */
+export function scale(value: StringValue | number, factor: number): number {
+  const msValue = toMilliseconds(value, 'scale');
+  if (typeof factor !== 'number' || !Number.isFinite(factor)) {
+    throw new Error(
+      `Value provided to scale() must be a finite number. value=${JSON.stringify(factor)}`,
+    );
+  }
+  return msValue * factor;
+}
