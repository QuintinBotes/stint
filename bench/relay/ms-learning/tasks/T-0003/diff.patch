+import { describe, expect, it } from '@jest/globals';
+import { clamp } from './index';
+
+describe('clamp', () => {
+  it('should clamp a value above max down to max', () => {
+    expect(clamp('2h', '1m', '1h')).toBe(3600000);
+  });
+
+  it('should clamp a value below min up to min', () => {
+    expect(clamp('30s', '1m', '1h')).toBe(60000);
+  });
+
+  it('should return the value when within bounds', () => {
+    expect(clamp(90000, '1m', '1h')).toBe(90000);
+  });
+
+  it('should return the bounds when the value equals them', () => {
+    expect(clamp('1m', '1m', '1h')).toBe(60000);
+    expect(clamp('1h', '1m', '1h')).toBe(3600000);
+  });
+
+  it('should accept numbers for all arguments', () => {
+    expect(clamp(5000, 1000, 2000)).toBe(2000);
+    expect(clamp(500, 1000, 2000)).toBe(1000);
+    expect(clamp(1500, 1000, 2000)).toBe(1500);
+  });
+
+  it('should accept duration strings for all arguments', () => {
+    expect(clamp('90s', '1m', '2m')).toBe(90000);
+  });
+
+  it('should work with negative durations', () => {
+    expect(clamp('-2h', '-1h', '1h')).toBe(-3600000);
+    expect(clamp('2h', '-1h', '1h')).toBe(3600000);
+    expect(clamp('-30m', '-1h', '1h')).toBe(-1800000);
+  });
+
+  it('should throw for non-finite numbers', () => {
+    expect(() => clamp(NaN, '1m', '1h')).toThrow();
+    expect(() => clamp('30m', NaN, '1h')).toThrow();
+    expect(() => clamp('30m', '1m', NaN)).toThrow();
+    expect(() => clamp(Infinity, '1m', '1h')).toThrow();
+    expect(() => clamp('30m', '1m', -Infinity)).toThrow();
+  });
+
+  it('should throw for invalid types', () => {
+    // @ts-expect-error - We expect this to throw.
+    expect(() => clamp(undefined, '1m', '1h')).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => clamp('30m', null, '1h')).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => clamp('30m', '1m', {})).toThrow();
+  });
+});
