+/**
+ * Hold a duration between two bounds, returning the duration in
+ * milliseconds clamped to the inclusive range `[min, max]`.
+ *
+ * @param value - A duration string (e.g. `'2h'`) or a number of milliseconds
+ * @param min - A duration string (e.g. `'1m'`) or a number of milliseconds
+ * @param max - A duration string (e.g. `'1h'`) or a number of milliseconds
+ * @returns The value in milliseconds, held between `min` and `max`
+ * @throws Error if any argument is not a string or a finite number
+ */
+export function clamp(
+  value: StringValue | number,
+  min: StringValue | number,
+  max: StringValue | number,
+): number {
+  const msValue = toMilliseconds(value, 'clamp');
+  const msMin = toMilliseconds(min, 'clamp');
+  const msMax = toMilliseconds(max, 'clamp');
+  return Math.min(Math.max(msValue, msMin), msMax);
 }
 
