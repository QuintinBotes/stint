+/**
+ * Return the whole number of seconds, rounded down, in a duration string or
+ * a number of milliseconds.
+ *
+ * @param value - A duration string (e.g. `'90s'`) or a number of milliseconds
+ * @returns The whole number of seconds, rounded down
+ * @throws Error if `value` is not a string or a finite number
+ */
+export function toSeconds(value: StringValue | number): number {
+  if (typeof value === 'string') {
+    return Math.floor(parse(value) / 1000);
+  }
+  if (typeof value === 'number') {
+    if (!Number.isFinite(value)) {
+      throw new Error(
+        `Value provided to toSeconds() must be a finite number. value=${JSON.stringify(value)}`,
+      );
+    }
+    return Math.floor(value / 1000);
+  }
+  throw new Error(
+    `Value provided to toSeconds() must be a string or number. value=${JSON.stringify(value)}`,
+  );
+}
