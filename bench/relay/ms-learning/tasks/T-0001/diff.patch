@@ -0,0 +1,41 @@
+import { describe, expect, it } from '@jest/globals';
+import { toSeconds } from './index';
+
+describe('toSeconds', () => {
+  it('should convert seconds string to seconds', () => {
+    expect(toSeconds('90s')).toBe(90);
+  });
+
+  it('should convert minutes string to seconds', () => {
+    expect(toSeconds('2m')).toBe(120);
+  });
+
+  it('should floor milliseconds to seconds', () => {
+    expect(toSeconds(1500)).toBe(1);
+  });
+
+  it('should floor fractional seconds from strings', () => {
+    expect(toSeconds('1500ms')).toBe(1);
+    expect(toSeconds('1.9s')).toBe(1);
+  });
+
+  it('should return 0 for sub-second values', () => {
+    expect(toSeconds(999)).toBe(0);
+    expect(toSeconds('500ms')).toBe(0);
+  });
+
+  it('should throw for non-finite numbers', () => {
+    expect(() => toSeconds(NaN)).toThrow();
+    expect(() => toSeconds(Infinity)).toThrow();
+    expect(() => toSeconds(-Infinity)).toThrow();
+  });
+
+  it('should throw for invalid types', () => {
+    // @ts-expect-error - We expect this to throw.
+    expect(() => toSeconds(undefined)).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => toSeconds(null)).toThrow();
+    // @ts-expect-error - We expect this to throw.
+    expect(() => toSeconds({})).toThrow();
+  });
+});
