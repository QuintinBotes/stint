@@ -0,0 +1,83 @@
+import { describe, expect, it } from '@jest/globals';
+import { format, ms, parse, parseStrict } from './index';
+
+describe('unit option', () => {
+  it('formats in the given unit', () => {
+    expect(format(5400000, { unit: 'm' })).toBe('90m');
+  });
+
+  it('formats long in the given unit', () => {
+    expect(format(5400000, { unit: 'minutes', long: true })).toBe('90 minutes');
+  });
+
+  it('accepts any spelling and case the parser takes', () => {
+    expect(format(5400000, { unit: 'Minutes' })).toBe('90m');
+    expect(format(5400000, { unit: 'MINS' })).toBe('90m');
+    expect(format(7200000, { unit: 'hrs' })).toBe('2h');
+    expect(format(7200000, { unit: 'hrs', long: true })).toBe('2 hours');
+  });
+
+  it('rounds to a whole number of the unit', () => {
+    expect(format(1500, { unit: 's' })).toBe('2s');
+    expect(format(1200, { unit: 's', long: true })).toBe('1 second');
+    expect(format(10000, { unit: 's', long: true })).toBe('10 seconds');
+  });
+
+  it('formats milliseconds unit', () => {
+    expect(format(500, { unit: 'ms' })).toBe('500ms');
+    expect(format(500, { unit: 'ms', long: true })).toBe('500 ms');
+    expect(format(-500, { unit: 'ms', long: true })).toBe('-500 ms');
+  });
+
+  it('formats other units short and long', () => {
+    expect(format(3600000, { unit: 'h' })).toBe('1h');
+    expect(format(86400000, { unit: 'd' })).toBe('1d');
+    expect(format(604800000, { unit: 'w' })).toBe('1w');
+    expect(format(31557600000, { unit: 'y' })).toBe('1y');
+    expect(format(31557600000, { unit: 'y', long: true })).toBe('1 year');
+    expect(format(2629800000, { unit: 'mo' })).toBe('1mo');
+    expect(format(2629800000, { unit: 'month', long: true })).toBe('1 month');
+    expect(format(-5400000, { unit: 'm' })).toBe('-90m');
+    expect(format(-5400000, { unit: 'minutes', long: true })).toBe(
+      '-90 minutes',
+    );
+  });
+
+  it('throws for unknown format unit and names it', () => {
+    expect(() => format(1000, { unit: 'bogus' as never })).toThrow('bogus');
+  });
+
+  it('parses a unitless number in the given unit', () => {
+    expect(parse('90', { unit: 's' })).toBe(90000);
+  });
+
+  it('lets a unit in the string win', () => {
+    expect(parse('2m', { unit: 's' })).toBe(120000);
+  });
+
+  it('leaves parsing unchanged without the option', () => {
+    expect(parse('100')).toBe(100);
+    expect(parse('100', {})).toBe(100);
+    expect(parse('1m')).toBe(60000);
+  });
+
+  it('parses unit option case-insensitively', () => {
+    expect(parse('90', { unit: 'MINS' })).toBe(5400000);
+    expect(parse('1', { unit: 'Minutes' })).toBe(60000);
+    expect(parse('2', { unit: 'hrs' })).toBe(7200000);
+  });
+
+  it('throws for unknown parse unit and names it', () => {
+    expect(() => parse('90', { unit: 'bogus' as never })).toThrow('bogus');
+  });
+
+  it('supports unit through ms()', () => {
+    expect(ms('90', { unit: 's' })).toBe(90000);
+    expect(ms(5400000, { unit: 'm' })).toBe('90m');
+    expect(ms(5400000, { unit: 'minutes', long: true })).toBe('90 minutes');
+  });
+
+  it('supports unit through parseStrict()', () => {
+    expect(parseStrict('90', { unit: 's' })).toBe(90000);
+  });
+});
