diff --git a/test/rate-limit.test.ts b/test/rate-limit.test.ts
new file mode 100644
index 0000000..250f174
--- /dev/null
+++ b/test/rate-limit.test.ts
@@ -0,0 +1,63 @@
+import { describe, expect, it } from 'vitest';
+import { RateLimiter } from '../src/lib/limiter';
+import { setup } from './helpers';
+
+describe('POST /webhooks rate limit', () => {
+  it('answers 429 with a Retry-After header when a tenant exceeds the limit', async () => {
+    const { postWebhook } = setup({ rateLimitMax: 2, rateLimitWindowMs: 60000 });
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(202);
+
+    const res = await postWebhook('tenant-a', { type: 'a' });
+    expect(res.status).toBe(429);
+    const retryAfter = res.headers.get('Retry-After');
+    expect(retryAfter).not.toBeNull();
+    expect(Number(retryAfter)).toBeGreaterThan(0);
+    expect(await res.json()).toMatchObject({ error: expect.any(String) });
+  });
+
+  it('does not rate-limit other tenants', async () => {
+    const { postWebhook } = setup({ rateLimitMax: 1, rateLimitWindowMs: 60000 });
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(429);
+    expect((await postWebhook('tenant-b', { type: 'a' })).status).toBe(202);
+  });
+
+  it('reads the limit from config rather than a constant', async () => {
+    const { postWebhook } = setup({ rateLimitMax: 3, rateLimitWindowMs: 60000 });
+    for (let i = 0; i < 3; i++) {
+      expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(202);
+    }
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(429);
+  });
+
+  it('does not store or audit rejected webhooks', async () => {
+    const { postWebhook, deps } = setup({ rateLimitMax: 1, rateLimitWindowMs: 60000 });
+    await postWebhook('tenant-a', { type: 'a' });
+    await postWebhook('tenant-a', { type: 'a' });
+    expect(deps.store.listByTenant('tenant-a')).toHaveLength(1);
+    expect(deps.audit.list('tenant-a')).toHaveLength(1);
+  });
+});
+
+describe('RateLimiter', () => {
+  it('resets the count after the window passes', () => {
+    const limiter = new RateLimiter();
+    expect(limiter.check('t', 1, 1000, 0).allowed).toBe(true);
+    expect(limiter.check('t', 1, 1000, 500).allowed).toBe(false);
+    expect(limiter.check('t', 1, 1000, 1000).allowed).toBe(true);
+  });
+
+  it('tracks tenants independently', () => {
+    const limiter = new RateLimiter();
+    expect(limiter.check('a', 1, 1000, 0).allowed).toBe(true);
+    expect(limiter.check('a', 1, 1000, 0).allowed).toBe(false);
+    expect(limiter.check('b', 1, 1000, 0).allowed).toBe(true);
+  });
+
+  it('reports Retry-After in whole seconds, rounded up', () => {
+    const limiter = new RateLimiter();
+    limiter.check('t', 1, 5000, 0);
+    expect(limiter.check('t', 1, 5000, 1500)).toEqual({ allowed: false, retryAfterSec: 4 });
+  });
+});
