diff --git a/src/routes/admin.ts b/src/routes/admin.ts
index c5cb715..1aee2f9 100644
--- a/src/routes/admin.ts
+++ b/src/routes/admin.ts
@@ -22,5 +22,14 @@ export function adminRoutes(deps: Deps): Hono {
     }
   });
 
+  r.delete('/tenants/:id', (c) => {
+    const id = c.req.param('id');
+    const tenant = deps.tenants.get(id);
+    if (!tenant) return c.json({ error: `unknown tenant ${id}` }, 404);
+    deps.tenants.remove(id);
+    deps.audit.record(id, 'tenant.deleted', id);
+    return c.json(tenant);
+  });
+
   return r;
 }
diff --git a/test/admin.test.ts b/test/admin.test.ts
index c936e52..0968308 100644
--- a/test/admin.test.ts
+++ b/test/admin.test.ts
@@ -34,4 +34,34 @@ describe('admin API', () => {
     await createTenant(send, { id: 'tenant-c', name: 'Tenant C' });
     expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(202);
   });
+
+  it('deletes a known tenant', async () => {
+    const { send } = setup();
+    const res = await send('/admin/tenants/tenant-a', { method: 'DELETE' });
+    expect(res.status).toBe(200);
+    expect(await res.json()).toMatchObject({ id: 'tenant-a' });
+    const body = (await (await send('/admin/tenants')).json()) as { tenants: Array<{ id: string }> };
+    expect(body.tenants.map((t) => t.id)).not.toContain('tenant-a');
+  });
+
+  it('answers 404 for an unknown tenant', async () => {
+    const { send } = setup();
+    const res = await send('/admin/tenants/nobody', { method: 'DELETE' });
+    expect(res.status).toBe(404);
+    expect(await res.json()).toEqual({ error: 'unknown tenant nobody' });
+  });
+
+  it('writes an audit entry for the deletion', async () => {
+    const { send, deps } = setup();
+    await send('/admin/tenants/tenant-a', { method: 'DELETE' });
+    expect(deps.audit.list()).toMatchObject([{ tenant: 'tenant-a', action: 'tenant.deleted', target: 'tenant-a' }]);
+  });
+
+  it('rejects webhooks for a deleted tenant', async () => {
+    const { send, postWebhook } = setup();
+    await createTenant(send, { id: 'tenant-c', name: 'Tenant C' });
+    expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(202);
+    expect((await send('/admin/tenants/tenant-c', { method: 'DELETE' })).status).toBe(200);
+    expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(404);
+  });
 });
