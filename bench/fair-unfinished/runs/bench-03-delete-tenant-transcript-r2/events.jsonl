{"id":"01M6F0NMESDTX1CSHT5ACJJ9VB","seq":66,"ts":"2026-11-02T20:54:31.641Z","task":"T-0001","run":"r2","adapter":"stint-agent","vendor":"meta","type":"agent.tool_call","payload":{"tool":"edit_file","args":{"new_text":"  it('lets a new tenant receive webhooks', async () => {\n    const { send, postWebhook } = setup();\n    await createTenant(send, { id: 'tenant-c', name: 'Tenant C' });\n    expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(202);\n  });\n\n  it('deletes a known tenant', async () => {\n    const { send } = setup();\n    const res = await send('/admin/tenants/tenant-a', { method: 'DELETE' });\n    expect(res.status).toBe(200);\n    expect(await res.json()).toMatchObject({ id: 'tenant-a' });\n    const body = (await (await send('/admin/tenants')).json()) as { tenants: Array<{ id: string }> };\n    expect(body.tenants.map((t) => t.id)).not.toContain('tenant-a');\n  });\n\n  it('answers 404 for an unknown tenant', async () => {\n    const { send } = setup();\n    const res = await send('/admin/tenants/nobody', { method: 'DELETE' });\n    expect(res.status).toBe(404);\n    expect(await res.json()).toEqual({ error: 'unknown tenant nobody' });\n  });\n\n  it('writes an audit entry for the deletion', async () => {\n    const { send, deps } = setup();\n    await send('/admin/tenants/tenant-a', { method: 'DELETE' });\n    expect(deps.audit.list()).toMatchObject([{ tenant: 'tenant-a', action: 'tenant.deleted', target: 'tenant-a' }]);\n  });\n\n  it('rejects webhooks for a deleted tenant', async () => {\n    const { send, postWebhook } = setup();\n    await createTenant(send, { id: 'tenant-c', name: 'Tenant C' });\n    expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(202);\n    expect((await send('/admin/tenants/tenant-c', { method: 'DELETE' })).status).toBe(200);\n    expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(404);\n  });\n});","old_text":"  it('lets a new tenant receive webhooks', async () => {\n    const { send, postWebhook } = setup();\n    await createTenant(send, { id: 'tenant-c', name: 'Tenant C' });\n    expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(202);\n  });\n});","path":"test/admin.test.ts"},"callId":"call_ac626a4d-9efd-4412-ac2a-8342ebf46181"},"prev":"56207c0c5b1de823c9dec025f70767e5e2c701fc7e86dcf9478c85b67987cb6c","hash":"f04b0099938f16483ce111c85644eff1d3938435ff6f7f64b08d2b2295d938d1"}
