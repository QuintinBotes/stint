{"id":"01M6F0J7HM6XDY7RXA734Q4H37","seq":55,"ts":"2026-11-02T20:52:40.116Z","task":"T-0001","run":"r2","adapter":"stint-agent","vendor":"meta","type":"agent.tool_call","payload":{"tool":"edit_file","args":{"new_text":"  it('lets a new tenant receive webhooks', async () => {\n    const { send, postWebhook } = setup();\n    await createTenant(send, { id: 'tenant-c', name: 'Tenant C' });\n    expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(202);\n  });\n\n  it('deletes a known tenant', async () => {\n    const { send } = setup();\n    const res = await send('/admin/tenants/tenant-a', { method: 'DELETE' });\n    expect(res.status).toBe(200);\n    const body = (await (await send('/admin/tenants')).json()) as { tenants: Array<{ id: string }> };\n    expect(body.tenants.map((t) => t.id)).toEqual(['tenant-b']);\n  });\n\n  it('answers 404 for an unknown tenant', async () => {\n    const { send } = setup();\n    expect((await send('/admin/tenants/nobody', { method: 'DELETE' })).status).toBe(404);\n  });\n\n  it('writes an audit entry for the deletion', async () => {\n    const { send, deps } = setup();\n    await send('/admin/tenants/tenant-a', { method: 'DELETE' });\n    expect(deps.audit.list('tenant-a')).toMatchObject([{ tenant: 'tenant-a', action: 'tenant.deleted', target: 'tenant-a' }]);\n  });\n\n  it('rejects webhooks for a deleted tenant', async () => {\n    const { send, postWebhook } = setup();\n    await send('/admin/tenants/tenant-a', { method: 'DELETE' });\n    expect((await postWebhook('tenant-a', { type: 'hello' })).status).toBe(404);\n  });\n});","old_text":"  it('lets a new tenant receive webhooks', async () => {\n    const { send, postWebhook } = setup();\n    await createTenant(send, { id: 'tenant-c', name: 'Tenant C' });\n    expect((await postWebhook('tenant-c', { type: 'hello' })).status).toBe(202);\n  });\n});","path":"test/admin.test.ts"},"callId":"call_782f570f-ca74-4cb0-bb15-1481c573e431"},"prev":"c18e105bf81ea89ad6eb173d505dd