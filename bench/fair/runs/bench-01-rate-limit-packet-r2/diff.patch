+++ b/test/webhooks-rate-limit.test.ts
@@ -0,0 +1,30 @@
+import { describe, expect, it } from 'vitest';
+import { setup } from './helpers';
+
+describe('POST /webhooks rate limiting', () => {
+  it('answers 429 with a Retry-After header when a tenant exceeds the limit', async () => {
+    const { postWebhook } = setup({ rateLimitMaxRequests: 2, rateLimitWindowMs: 60000 });
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: 'b' })).status).toBe(202);
+
+    const res = await postWebhook('tenant-a', { type: 'c' });
+    expect(res.status).toBe(429);
+    expect(res.headers.get('Retry-After')).not.toBeNull();
+    expect(Number(res.headers.get('Retry-After'))).toBeGreaterThan(0);
+  });
+
+  it('does not rate-limit other tenants', async () => {
+    const { postWebhook } = setup({ rateLimitMaxRequests: 1, rateLimitWindowMs: 60000 });
+    expect((await postWebhook('tenant-a', { type: 'a' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: 'b' })).status).toBe(429);
+    expect((await postWebhook('tenant-b', { type: 'b' })).status).toBe(202);
+  });
+
+  it('reads the limit and window from config', async () => {
+    const { postWebhook } = setup({ rateLimitMaxRequests: 3, rateLimitWindowMs: 60000 });
+    expect((await postWebhook('tenant-a', { type: '1' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: '2' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: '3' })).status).toBe(202);
+    expect((await postWebhook('tenant-a', { type: '4' })).status).toBe(429);
+  });
+});
