@@ -0,0 +1,117 @@
+import { describe, expect, it } from '@jest/globals';
+import { format, ms, parse, parseStrict } from './index';
+
+describe('format with unit', () => {
+  it('should format 5400000ms as 90m', () => {
+    expect(format(5400000, { unit: 'm' })).toBe('90m');
+  });
+  it('should format with long minutes', () => {
+    expect(format(5400000, { unit: 'minutes', long: true })).toBe('90 minutes');
+  });
+  it('should format with unit case-insensitive', () => {
+    expect(format(5400000, { unit: 'Minutes' })).toBe('90m');
+    expect(format(5400000, { unit: 'MINS' })).toBe('90m');
+    expect(format(5400000, { unit: 'hrs' })).toBe('2h');
+  });
+  it('should round to whole number of that unit', () => {
+    expect(format(1500, { unit: 's' })).toBe('2s');
+    expect(format(1499, { unit: 's' })).toBe('1s');
+    expect(format(-1500, { unit: 's' })).toBe('-1s');
+  });
+  it('should support long singular and plural via unit', () => {
+    expect(format(60000, { unit: 'm', long: true })).toBe('1 minute');
+    expect(format(120000, { unit: 'm', long: true })).toBe('2 minutes');
+    expect(format(-60000, { unit: 'm', long: true })).toBe('-1 minute');
+  });
+  it('should support ms unit long', () => {
+    expect(format(500, { unit: 'ms', long: true })).toBe('500 ms');
+    expect(format(500, { unit: 'ms' })).toBe('500ms');
+    expect(format(-500, { unit: 'milliseconds', long: true })).toBe('-500 ms');
+  });
+  it('should handle ms wrapper with unit', () => {
+    expect(ms(5400000, { unit: 'm' })).toBe('90m');
+    expect(ms(5400000, { unit: 'minutes', long: true })).toBe('90 minutes');
+  });
+  it('should throw for unknown unit in format', () => {
+    expect(() => format(1000, { unit: 'invalid' as any })).toThrow(
+      'Unknown unit "invalid"',
+    );
+    expect(() => ms(1000, { unit: 'bogus' as any })).toThrow(
+      'Unknown unit "bogus"',
+    );
+  });
+});
+
+describe('parse with unit', () => {
+  it('should parse number without unit using option', () => {
+    expect(parse('90', { unit: 's' })).toBe(90000);
+  });
+  it('unit in string wins over option', () => {
+    expect(parse('2m', { unit: 's' })).toBe(120000);
+    expect(parse('2m', { unit: 's', long: true } as any)).toBe(120000);
+  });
+  it('should handle case-insensitive unit options', () => {
+    expect(parse('90', { unit: 'Minutes' })).toBe(5400000);
+    expect(parse('90', { unit: 'MINS' })).toBe(5400000);
+    expect(parse('2', { unit: 'hrs' })).toBe(7200000);
+    expect(parse('1', { unit: 'H' })).toBe(3600000);
+  });
+  it('should default to ms without option', () => {
+    expect(parse('100')).toBe(100);
+    expect(parse('100', {})).toBe(100);
+  });
+  it('should work via ms wrapper', () => {
+    expect(ms('90', { unit: 's' })).toBe(90000);
+    expect(ms('2m', { unit: 's' })).toBe(120000);
+  });
+  it('should work via parseStrict', () => {
+    expect(parseStrict('90' as any, { unit: 's' })).toBe(90000);
+  });
+  it('should throw for unknown unit in parse', () => {
+    expect(() => parse('90', { unit: 'invalid' as any })).toThrow(
+      'Unknown unit "invalid"',
+    );
+    expect(() => ms('90' as any, { unit: 'bogus' as any })).toThrow(
+      'Unknown unit "bogus"',
+    );
+    expect(() => parseStrict('90' as any, { unit: 'nope' as any })).toThrow(
+      'Unknown unit "nope"',
+    );
+  });
+  it('should parse via unit option for all unit groups to cover branches', () => {
+    expect(parse('1', { unit: 'y' })).toBe(31557600000);
+    expect(parse('1', { unit: 'mo' })).toBe(2629800000);
+    expect(parse('1', { unit: 'w' })).toBe(604800000);
+    expect(parse('1', { unit: 'd' })).toBe(86400000);
+    expect(parse('1', { unit: 'h' })).toBe(3600000);
+    expect(parse('1', { unit: 'm' })).toBe(60000);
+    expect(parse('1', { unit: 's' })).toBe(1000);
+    expect(parse('1', { unit: 'ms' })).toBe(1);
+  });
+  it('should handle negative and decimal with unit option', () => {
+    expect(parse('-1.5', { unit: 'h' })).toBe(-5400000);
+    expect(parse('.5', { unit: 's' })).toBe(500);
+  });
+});
+
+describe('format rounding with unit edge', () => {
+  it('should round zero', () => {
+    expect(format(0, { unit: 's' })).toBe('0s');
+    expect(format(0, { unit: 's', long: true })).toBe('0 second');
+  });
+  it('should round long seconds', () => {
+    expect(format(500, { unit: 's', long: true })).toBe('1 second');
+    expect(format(1500, { unit: 's', long: true })).toBe('2 seconds');
+    // negative rounding: -1500ms in s => Math.round(-1.5) = -1 but plural uses original ms
+    // original msAbs 1500 >= 1500 => plural threshold met => "-1 seconds" currently?
+    // Let's verify actual: plural(-1500,1500,1000,'second') => "-1 seconds"
+    // but with unit path we do plural(ms,abs(ms),div, name) where ms is original ms
+    expect(format(-1500, { unit: 's', long: true })).toBe('-1 seconds');
+  });
+  it('should format months/years via unit', () => {
+    expect(format(2629800000, { unit: 'mo' })).toBe('1mo');
+    expect(format(31557600000, { unit: 'y' })).toBe('1y');
+    expect(format(2629800000, { unit: 'mo', long: true })).toBe('1 month');
+    expect(format(31557600000 * 2, { unit: 'y', long: true })).toBe('2 years');
+  });
+});
